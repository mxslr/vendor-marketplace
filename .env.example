# ─────────────────────────────────────────
# Database (Supabase PostgreSQL)
# ─────────────────────────────────────────
# Transaction mode (runtime / pooling) — port 6543
DATABASE_URL=

# Direct connection (migrations / prisma generate) — port 5432
DIRECT_URL=

# ─────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────
# Auth
# ─────────────────────────────────────────
JWT_SECRET=

# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
PORT=4000

# ─────────────────────────────────────────
# Stream Chat
# ─────────────────────────────────────────
STREAM_API_KEY=
STREAM_API_SECRET=

# ─────────────────────────────────────────
# Midtrans
# ─────────────────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# ─────────────────────────────────────────
# Email (SMTP) — for dividend report emails
# ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CSC_EMAIL=
CCI_EMAIL=
